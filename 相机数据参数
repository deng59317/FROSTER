class CameraAIController:
    """Pilot640DSL-RJ45 双光车载热像仪 AI功能控制器（根据说明书协议实现）"""
    
    def __init__(self, camera_ip="192.168.1.100", camera_port=8067, debug=True):
        self.camera_ip = camera_ip
        self.camera_port = camera_port
        self.timeout = 10  # 增加到10秒超时，给摄像头更多处理时间
        self.debug = debug  # 调试模式
    
    def calculate_checksum(self, cmd_type, data_length, data_body):
        """计算校验位：仅对命令类型、数据长度和数据主体计算二进制1的个数"""
        total_ones = 0
        
        # 命令类型
        total_ones += bin(cmd_type).count('1')
        
        # 数据有效长度
        total_ones += bin(data_length).count('1')
        
        # 数据主体
        if isinstance(data_body, list):
            for byte in data_body:
                total_ones += bin(byte).count('1')
        else:
            total_ones += bin(data_body).count('1')
        
        return total_ones & 0xFFFF  # 返回16位值
    
    def build_ai_command(self, enable_ai=False):
        """
        构建AI控制命令（根据最新协议说明）
        完整格式：A0 0F 02 01 01 00 00 00 00 00 00 03 00 E0 A0 (15字节)
        
        Args:
            enable_ai (bool): True=开启AI, False=关闭AI
            
        Returns:
            bytes: 完整的命令字节序列
        """
        # 根据协议说明构建完整的15字节命令
        if enable_ai:
            # 开启AI命令：A0 0F 02 01 00 00 00 00 00 00 00 02 00 E0 A0
            # 校验位计算：02(1个1) + 01(1个1) + 00(0个1) = 2个1 → 0x0002
            command = bytes.fromhex("A0 0F 02 01 00 00 00 00 00 00 00 02 00 E0 A0")
            action = "开启"
        else:
            # 关闭AI命令：A0 0F 02 01 01 00 00 00 00 00 00 03 00 E0 A0
            # 校验位计算：02(1个1) + 01(1个1) + 01(1个1) = 3个1 → 0x0003
            command = bytes.fromhex("A0 0F 02 01 01 00 00 00 00 00 00 03 00 E0 A0")
            action = "关闭"
        
        if self.debug:
            print(f"🔧 构建{action}AI命令 (15字节完整格式):")
            print(f"   命令头: A0 0F")
            print(f"   命令类型: 02 (设置AI状态)")
            print(f"   数据长度: 01")
            print(f"   AI状态: {'00 (开启)' if enable_ai else '01 (关闭)'}")
            print(f"   填充字节: 00 00 00 00 00 00")
            print(f"   校验位: {'02 00' if enable_ai else '03 00'} (小端序)")
            print(f"   命令尾: E0 A0")
            print(f"   完整命令: {command.hex().upper()}")
        
        return command
    
    def send_command(self, command, description="", expect_response=True):
        """
        发送命令到摄像头
        
        Args:
            command (bytes): 要发送的命令
            description (str): 命令描述
            expect_response (bool): 是否等待并解析响应
            
        Returns:
            tuple: (success, response_data, error_message)
        """
        try:
            # 建立TCP连接
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(self.timeout)
            
            print(f"🔗 正在连接摄像头 {self.camera_ip}:{self.camera_port}")
            sock.connect((self.camera_ip, self.camera_port))
            
            # 发送命令
            sock.send(command)
            print(f"📤 {description}命令已发送: {command.hex().upper()}")
            
            if not expect_response:
                print(f"✅ {description}操作已发送 (不等待响应)")
                sock.close()
                return True, None, None  # 假设成功
            
            # 等待摄像头处理命令
            import time
            time.sleep(0.5)  # 等待500ms让摄像头处理命令
            
            # 接收响应
            response = sock.recv(1024)
            print(f"📥 摄像头响应: {response.hex().upper()}")
            
            # 如果响应为空，再等待一下重试
            if len(response) == 0:
                print("⏳ 响应为空，等待重试...")
                time.sleep(1.0)
                response = sock.recv(1024)
                print(f"📥 重试响应: {response.hex().upper()}")
            
            # 解析响应状态（根据说明书命令返回格式）
            if len(response) >= 4:
                # 响应格式：FF F0 [状态码2字节小端序] [命令类型] [数据主体] ... AA A0
                if response[0] == 0xFF and response[1] == 0xF0:
                    status_code = int.from_bytes(response[2:4], byteorder='little')
                    
                    # 验证返回尾部（应该是 AA A0）
                    if len(response) >= 2:
                        tail = response[-2:]
                        if tail[0] != 0xAA or tail[1] != 0xA0:
                            print(f"⚠️ 响应尾部异常: {tail.hex().upper()}, 期望: AA A0")
                    
                    # 状态码含义（参考说明书错误码表）
                    status_messages = {
                        0x0000: "操作成功",
                        0x0001: "命令格式错误",
                        0x0002: "校验位错误", 
                        0x0003: "命令类型不支持",
                        0x0004: "数据长度错误",
                        0x0005: "参数值超出范围",
                        0x0006: "设备忙碌",
                        0x0007: "操作失败"
                    }
                    
                    if status_code == 0x0000:
                        print(f"✅ {description}操作成功")
                        return True, response, None
                    else:
                        status_msg = status_messages.get(status_code, f"未知错误码: 0x{status_code:04X}")
                        error_msg = f"{description}操作失败 - {status_msg}"
                        print(f"❌ {error_msg}")
                        return False, response, error_msg
                else:
                    error_msg = f"无效的响应头: {response[:2].hex().upper()}, 期望: FF F0"
                    print(f"⚠️ {error_msg}")
                    return False, response, error_msg
            else:
                error_msg = f"响应数据太短: {len(response)} 字节，期望至少4字节"
                print(f"⚠️ {error_msg}")
                return False, response, error_msg
                
        except socket.timeout:
            error_msg = f"连接超时 ({self.timeout}秒)"
            print(f"⏰ {error_msg}")
            print(f"🔍 网络诊断: 请检查摄像头IP({self.camera_ip})和端口({self.camera_port})是否正确")
            print(f"💡 建议: 1) 确认摄像头已开机 2) 检查网络连通性 3) 验证IP地址")
            return False, None, error_msg
        except ConnectionRefusedError:
            error_msg = f"连接被拒绝，请检查摄像头IP和端口"
            print(f"🚫 {error_msg}")
            print(f"💡 可能原因: 1) 端口{self.camera_port}未开放 2) 摄像头控制服务未启动")
            return False, None, error_msg
        except OSError as e:
            if "No route to host" in str(e):
                error_msg = f"网络不可达: {self.camera_ip}"
                print(f"🌐 {error_msg}")
                print(f"💡 请检查: 1) 网络连接 2) IP地址是否在同一网段")
            else:
                error_msg = f"网络错误: {e}"
                print(f"🔌 {error_msg}")
            return False, None, error_msg
        except Exception as e:
            error_msg = f"发送命令时出错: {e}"
            print(f"❌ {error_msg}")
            return False, None, error_msg
        finally:
            try:
                sock.close()
            except:
                pass
    
    def disable_ai(self):
        """关闭摄像头AI功能"""
        command = self.build_ai_command(enable_ai=False)
        # 不等待响应，避免超时问题
        return self.send_command(command, "关闭AI", expect_response=False)
    
    def enable_ai(self):
        """开启摄像头AI功能"""
