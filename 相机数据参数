    def send_single_simulation(self):
        """发送单张图片的模拟消息"""
        image_path = self.test_image_path_var.get()
        if not image_path:
            messagebox.showerror("错误", "请先选择测试图片！")
            return
        
        if not os.path.exists(image_path):
            messagebox.showerror("错误", "图片文件不存在！")
            return
        
        # 检查Kafka连接
        if not self.kafka_producer or not self.kafka_producer.is_connected:
            messagebox.showerror("错误", "Kafka未连接！请先测试Kafka连接。")
            return
        
        def send_simulation():
            try:
                self.simulation_status_var.set("正在发送模拟消息...")
                self.simulation_status_label.configure(foreground="blue")
                self.root.update()
                
                # 读取图片
                image = cv2.imread(image_path)
                if image is None:
                    raise Exception("无法读取图片文件")
                
                # 模拟检测结果
                class_name = self.simulation_class_var.get()
                confidence = self.simulation_confidence_var.get()
                
                # 生成模拟的边界框（图片中心区域）
                h, w = image.shape[:2]
                margin = 0.2  # 20%边距
                x1 = int(w * margin)
                y1 = int(h * margin)
                x2 = int(w * (1 - margin))
                y2 = int(h * (1 - margin))
                bbox = [x1, y1, x2, y2]
                
                # 创建模拟检测对象
                detection = {
                    'class_name': class_name,
                    'confidence': confidence,
                    'bbox': bbox
                }
                
                # 创建图片快照
                detection_snapshot = self._create_simulation_detection_snapshot(image, bbox, class_name)
                
                # 使用标准化方法创建检测对象
                standard_detection = self.create_standard_detection_object(
                    class_name=class_name,
                    confidence=confidence,
                    bbox=bbox,
                    additional_data={
                        'detection_snapshot': detection_snapshot,
                        'simulation_source': os.path.basename(image_path),
                        'timestamp': time.time()
                    }
                )
                
                # 创建完整场景快照
                scene_snapshot = self._create_simulation_scene_snapshot(image, [detection])
                
                # 使用标准化方法创建预警消息
                alert_message = self.create_standard_alert_message(
                    camera_id=self.camera_id_var.get(),
                    detections=[standard_detection],
                    camera_location=self.camera_location_var.get(),
                    additional_data={
                        'snapshot': scene_snapshot,
                        'confidence_threshold': self.confidence_var.get(),
                        'simulation_mode': True,
                        'simulation_source': image_path,
                        'message_type': 'simulation_test'
                    }
                )
                
                # 发送到Kafka
                success = self.kafka_producer.send_alert(alert_message)
                
                if success:
                    self.simulation_status_var.set("模拟消息发送成功")
                    self.simulation_status_label.configure(foreground="green")
                    self.log_kafka_message(f"✅ 模拟消息已发送: {class_name} (置信度: {confidence:.2f})")
                    self.log_kafka_message(f"📷 图片来源: {os.path.basename(image_path)}")
                    messagebox.showinfo("成功", f"模拟消息已发送到Kafka！\n\n异常类型: {class_name}\n置信度: {confidence:.2f}\n图片: {os.path.basename(image_path)}")
                else:
                    self.simulation_status_var.set("发送失败")
                    self.simulation_status_label.configure(foreground="red")
                    self.log_kafka_message(f"❌ 模拟消息发送失败")
                    messagebox.showerror("错误", "模拟消息发送失败！")
                
            except Exception as e:
                self.simulation_status_var.set("发送异常")
                self.simulation_status_label.configure(foreground="red")
                self.log_kafka_message(f"❌ 模拟消息异常: {e}")
                messagebox.showerror("错误", f"发送模拟消息失败: {e}")
        
        # 在新线程中执行，避免阻塞GUI
        threading.Thread(target=send_simulation, daemon=True).start()
    
    def send_batch_simulation(self):
        """批量发送目录下所有图片的模拟消息"""
        image_path = self.test_image_path_var.get()
        
        # 如果输入的是文件，则使用其目录
        if os.path.isfile(image_path):
            directory = os.path.dirname(image_path)
        elif os.path.isdir(image_path):
            directory = image_path
        else:
            # 让用户选择目录
            directory = filedialog.askdirectory(title="选择包含测试图片的目录")
            if not directory:
                return
        
        # 检查Kafka连接
        if not self.kafka_producer or not self.kafka_producer.is_connected:
            messagebox.showerror("错误", "Kafka未连接！请先测试Kafka连接。")
            return
        
        def send_batch():
            try:
                self.simulation_status_var.set("正在扫描图片...")
                self.simulation_status_label.configure(foreground="blue")
                self.root.update()
                
                # 查找所有图片文件
                image_extensions = {'.jpg', '.jpeg', '.png', '.bmp', '.tiff', '.tif'}
                image_files = []
                
                for file in os.listdir(directory):
                    if os.path.splitext(file.lower())[1] in image_extensions:
                        image_files.append(os.path.join(directory, file))
                
                if not image_files:
                    messagebox.showwarning("警告", f"目录中未找到图片文件！\n目录: {directory}")
                    return
                
                # 确认批量发送
                if not messagebox.askyesno("确认批量发送", 
                                         f"找到 {len(image_files)} 个图片文件。\n"
                                         f"将使用异常类型: {self.simulation_class_var.get()}\n"
                                         f"置信度: {self.simulation_confidence_var.get():.2f}\n\n"
                                         f"确定要发送所有模拟消息吗？"):
                    self.simulation_status_var.set("批量发送已取消")
                    self.simulation_status_label.configure(foreground="gray")
                    return
                
                # 批量发送
                success_count = 0
                failed_count = 0
                class_name = self.simulation_class_var.get()
                confidence = self.simulation_confidence_var.get()
                
                for i, image_path in enumerate(image_files, 1):
                    try:
                        self.simulation_status_var.set(f"发送中 {i}/{len(image_files)}: {os.path.basename(image_path)}")
                        self.root.update()
                        
                        # 读取图片
                        image = cv2.imread(image_path)
                        if image is None:
                            failed_count += 1
                            self.log_kafka_message(f"❌ 无法读取图片: {os.path.basename(image_path)}")
                            continue
                        
                        # 生成模拟的边界框
                        h, w = image.shape[:2]
                        margin = 0.2
                        x1 = int(w * margin)
                        y1 = int(h * margin)
                        x2 = int(w * (1 - margin))
                        y2 = int(h * (1 - margin))
                        bbox = [x1, y1, x2, y2]
                        
                        # 创建图片快照
                        detection_snapshot = self._create_simulation_detection_snapshot(image, bbox, class_name)
                        
                        # 创建标准检测对象
                        standard_detection = self.create_standard_detection_object(
                            class_name=class_name,
                            confidence=confidence,
                            bbox=bbox,
                            additional_data={
                                'detection_snapshot': detection_snapshot,
                                'simulation_source': os.path.basename(image_path),
                                'timestamp': time.time(),
                                'batch_index': i,
                                'batch_total': len(image_files)
                            }
                        )
                        
                        # 创建完整场景快照
                        scene_snapshot = self._create_simulation_scene_snapshot(image, [{'class_name': class_name, 'confidence': confidence, 'bbox': bbox}])
                        
                        # 创建预警消息
                        alert_message = self.create_standard_alert_message(
                            camera_id=self.camera_id_var.get(),
                            detections=[standard_detection],
                            camera_location=self.camera_location_var.get(),
                            additional_data={
                                'snapshot': scene_snapshot,
                                'confidence_threshold': self.confidence_var.get(),
                                'simulation_mode': True,
                                'simulation_source': image_path,
                                'message_type': 'simulation_batch_test',
                                'batch_info': {
                                    'index': i,
                                    'total': len(image_files),
                                    'directory': directory
                                }
                            }
                        )
                        
                        # 发送到Kafka
                        success = self.kafka_producer.send_alert(alert_message)
                        
                        if success:
                            success_count += 1
                            self.log_kafka_message(f"✅ 批量 {i}/{len(image_files)}: {os.path.basename(image_path)}")
                        else:
                            failed_count += 1
                            self.log_kafka_message(f"❌ 批量发送失败: {os.path.basename(image_path)}")
                        
                        # 控制发送频率，避免过快
                        time.sleep(0.1)
                        
                    except Exception as e:
                        failed_count += 1
                        self.log_kafka_message(f"❌ 处理失败 {os.path.basename(image_path)}: {e}")
                
                # 显示批量发送结果
                self.simulation_status_var.set(f"批量发送完成: {success_count}成功, {failed_count}失败")
                if failed_count == 0:
                    self.simulation_status_label.configure(foreground="green")
                else:
                    self.simulation_status_label.configure(foreground="orange")
                
                messagebox.showinfo("批量发送完成", 
                                  f"批量模拟消息发送完成！\n\n"
                                  f"总图片数: {len(image_files)}\n"
                                  f"发送成功: {success_count}\n"
                                  f"发送失败: {failed_count}\n"
                                  f"异常类型: {class_name}\n"
                                  f"置信度: {confidence:.2f}")
                
            except Exception as e:
                self.simulation_status_var.set("批量发送异常")
                self.simulation_status_label.configure(foreground="red")
                self.log_kafka_message(f"❌ 批量发送异常: {e}")
                messagebox.showerror("错误", f"批量发送失败: {e}")
        
        # 在新线程中执行
        threading.Thread(target=send_batch, daemon=True).start()
    
    def _create_simulation_detection_snapshot(self, image, bbox, class_name):
        """为模拟测试创建检测结果的裁剪图片快照"""
        try:
            x1, y1, x2, y2 = map(int, bbox)
            
            # 确保坐标在图像范围内
            h, w = image.shape[:2]
            x1, x2 = max(0, x1), min(w, x2)
            y1, y2 = max(0, y1), min(h, y2)
            
            # 裁剪图片
            crop = image[y1:y2, x1:x2]
            
            # 编码为Base64
            crop_base64, crop_size = self._encode_image_to_base64(crop, 85, (400, 300))
            
            return {
                "rgb_crop_base64": crop_base64,
                "ir_crop_base64": crop_base64,  # 模拟测试中RGB和IR使用相同图片
                "crop_size": [crop_size[0], crop_size[1]],
                "image_format": "jpeg",
                "image_quality": 85,
                "crop_region": [float(x1), float(y1), float(x2), float(y2)],
                "simulation_note": "模拟测试图片，RGB和IR相同"
            }
        except Exception as e:
            print(f"创建模拟检测快照失败: {e}")
            return None
    
    def _create_simulation_scene_snapshot(self, image, detections):
        """为模拟测试创建完整场景图片快照"""
        try:
            # 创建带有检测框的标注图片
            annotated_image = image.copy()
            
            for detection in detections:
                bbox = detection['bbox']
                class_name = detection['class_name']
                confidence = detection['confidence']
                
                x1, y1, x2, y2 = map(int, bbox)
                color = (0, 0, 255)  # 红色框表示异常
                
                # 绘制检测框
                cv2.rectangle(annotated_image, (x1, y1), (x2, y2), color, 3)
                
                # 绘制标签
                label = f"{class_name}: {confidence:.2f}"
                label_size = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.7, 2)[0]
                cv2.rectangle(annotated_image, (x1, y1-label_size[1]-10), 
                            (x1+label_size[0], y1), color, -1)
                cv2.putText(annotated_image, label, (x1, y1-5), 
                          cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
            
            # 编码为Base64
            image_base64, image_size = self._encode_image_to_base64(annotated_image, 75, (640, 480))
            
            return {
                "rgb_image_base64": image_base64,
                "ir_image_base64": image_base64,  # 模拟测试中RGB和IR使用相同图片
                "image_format": "jpeg",
                "image_size": [image_size[0], image_size[1]],
                "image_quality": 75,
                "has_annotations": True,
                "description": "模拟测试完整场景图片，包含检测框",
                "simulation_note": "模拟测试图片，RGB和IR相同"
            }
        except Exception as e:
            print(f"创建模拟场景快照失败: {e}")
            return None
    
    def _encode_image_to_base64(self, image, quality=85, resize_to=None):
        """将OpenCV图片编码为Base64字符串"""
        try:
            # 调整图片尺寸
            if resize_to:
                h, w = image.shape[:2]
                target_w, target_h = resize_to
                
                # 保持长宽比
                scale = min(target_w/w, target_h/h)
                new_w, new_h = int(w*scale), int(h*scale)
                
                if new_w != w or new_h != h:
                    image = cv2.resize(image, (new_w, new_h))
                
                resize_to = (new_w, new_h)
            
            # 编码为JPEG
            encode_params = [cv2.IMWRITE_JPEG_QUALITY, quality]
            success, encoded_image = cv2.imencode('.jpg', image, encode_params)
            
            if not success:
                raise Exception("图片编码失败")
            
            # 转换为Base64
            import base64
            image_base64 = base64.b64encode(encoded_image.tobytes()).decode('utf-8')
            image_base64_with_prefix = f"data:image/jpeg;base64,{image_base64}"
            
            final_size = resize_to if resize_to else (image.shape[1], image.shape[0])
            
            return image_base64_with_prefix, final_size
            
        except Exception as e:
            print(f"图片编码失败: {e}")
            return None, None
    
