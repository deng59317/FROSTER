    def _create_detection_snapshot(self, rgb_frame, ir_frame, bbox, class_name):
        """创建检测结果的裁剪图片快照"""
        try:
            from realtime_dual_modal_detection import encode_image_to_base64
            
            x1, y1, x2, y2 = map(int, bbox)
            
            # 确保坐标在图像范围内
            h, w = rgb_frame.shape[:2]
            x1, x2 = max(0, x1), min(w, x2)
            y1, y2 = max(0, y1), min(h, y2)
            
            # 裁剪图片
            rgb_crop = rgb_frame[y1:y2, x1:x2]
            ir_crop = ir_frame[y1:y2, x1:x2]
            
            # 编码为Base64
            rgb_base64, rgb_size = encode_image_to_base64(rgb_crop, 85, (640, 480))
            ir_base64, ir_size = encode_image_to_base64(ir_crop, 85, (640, 480))
            
            return {
                "rgb_crop_base64": rgb_base64,
                "ir_crop_base64": ir_base64,
                "crop_size": [rgb_size[0], rgb_size[1]],
                "image_format": "jpeg",
                "image_quality": 85,
                "crop_region": [float(x1), float(y1), float(x2), float(y2)]
            }
        except Exception as e:
            print(f"创建检测快照失败: {e}")
            return None
    
    def _create_full_scene_snapshot(self, rgb_frame, ir_frame, detections):
        """创建完整场景图片快照"""
        try:
            from realtime_dual_modal_detection import encode_image_to_base64, create_annotated_frame
            
            # 创建带有检测框的标注图片
            rgb_annotated = create_annotated_frame(rgb_frame, detections)
            ir_annotated = create_annotated_frame(ir_frame, detections)
            
            # 编码为Base64
            rgb_base64, rgb_size = encode_image_to_base64(rgb_annotated, 75, (640, 480))
            ir_base64, ir_size = encode_image_to_base64(ir_annotated, 75, (640, 480))
            
            return {
                "rgb_image_base64": rgb_base64,
                "ir_image_base64": ir_base64,
                "image_format": "jpeg",
                "image_size": [rgb_size[0], rgb_size[1]],
                "image_quality": 75,
                "has_annotations": True,
                "description": "完整场景图片，包含所有检测框"
            }
        except Exception as e:
            print(f"创建场景快照失败: {e}")
            return None
    
    def log_kafka_message(self, message):
        """记录Kafka日志"""
        timestamp = datetime.now().strftime("%H:%M:%S")
        log_message = f"[{timestamp}] {message}\n"
        
        self.kafka_log_text.insert(tk.END, log_message)
        self.kafka_log_text.see(tk.END)
        
        # 限制日志长度
        lines = self.kafka_log_text.get("1.0", tk.END).split('\n')
        if len(lines) > 100:
            self.kafka_log_text.delete("1.0", "10.0")
    
