                radar_info += "目标详情:\n"
                for i, target in enumerate(targets, 1):
                    status = "⚠️超速" if target['超速'] else "正常"
                    radar_info += f"{i}. ID:{target['目标编号']} "
                    radar_info += f"速度:{target['速度(m/s)']:.2f}m/s "
                    radar_info += f"距离:{target['距离(m)']:.2f}m "
                    radar_info += f"[{status}]\n"
                    
                    if i >= 8:  # 限制显示数量
                        radar_info += f"... 还有{len(targets)-8}个目标\n"
                        break
            else:
                radar_info += "无目标检测"
        
        self.radar_text.delete(1.0, tk.END)
        self.radar_text.insert(1.0, radar_info)
    
    def save_screenshot(self):
        """保存截图"""
        if not self.is_running:
            return
        
        try:
            ret_rgb, rgb_frame = self.rgb_cap.read_latest_frame()
            if ret_rgb and rgb_frame is not None:
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                filename = f"screenshot_{timestamp}.jpg"
                cv2.imwrite(filename, rgb_frame)
                messagebox.showinfo("成功", f"截图已保存: {filename}\n使用RTSCapture最新帧")
            else:
                messagebox.showwarning("警告", "无法获取当前帧，请确保视频流正常")
        except Exception as e:
            messagebox.showerror("错误", f"保存截图失败: {e}")
    
    
    
