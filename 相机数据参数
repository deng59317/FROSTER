    def set_work_mode(self, mode=1):
        """
        设置工作模式（根据协议说明）
        
        Args:
            mode (int): 0=自动切换, 1=双路输出(默认), 2=融合模式
            
        Returns:
            tuple: (success, response_data, error_message)
        """
        # 构建15字节工作模式命令，参考AI命令格式
        mode_value = mode & 0xFF
        
        # 计算校验位：00(0个1) + 01(1个1) + mode_value的1的个数
        checksum = 1 + bin(mode_value).count('1')  # 命令类型00 + 数据长度01 + 模式值
        
        # 构建完整命令
        command_hex = f"A0 0F 00 01 {mode_value:02X} 00 00 00 00 00 00 {checksum:02X} 00 E0 A0"
        command = bytes.fromhex(command_hex)
        
        mode_names = {0: "自动切换", 1: "双路输出", 2: "融合模式"}
        mode_desc = mode_names.get(mode, f"模式{mode}")
        
        if self.debug:
            print(f"🔧 构建设置工作模式命令 ({mode_desc}):")
            print(f"   完整命令: {command.hex().upper()}")
        
        return self.send_command(command, f"设置工作模式为{mode_desc}", expect_response=False)
    
