                            messagebox.showwarning("警告", "AI关闭命令已发送，但状态验证失败")
                    else:
                        messagebox.showerror("错误", f"关闭摄像头AI失败: {error}")
                        
            except Exception as e:
                messagebox.showerror("错误", f"切换摄像头AI状态异常: {e}")
            
            self.status_var.set("就绪")
        
        # 在新线程中执行，避免阻塞GUI
