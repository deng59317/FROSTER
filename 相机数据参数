    @classmethod
    def create_standard_detection_object(cls, class_name, confidence, bbox, additional_data=None):
        """
        创建标准检测对象
        
        Args:
            class_name (str): 检测类别名称
            confidence (float): 置信度 (0-1)
            bbox (list): 边界框 [x1, y1, x2, y2]
            additional_data (dict): 附加数据
            
        Returns:
            dict: 标准检测对象
        """
        detection_obj = {
            'class_name': class_name,
            'confidence': float(confidence),
            'bbox': [float(x) for x in bbox],
            'alert_level': cls.CLASS_TO_ALERT_LEVEL.get(class_name, 'medium'),
            'description': cls.CLASS_TO_DESCRIPTION.get(class_name, class_name),
            'message': cls.CLASS_TO_DETAILED_MESSAGE.get(class_name, f'检测到{class_name}行为')  # 改为message字段
        }
        
        if additional_data:
            detection_obj.update(additional_data)
            
        return detection_obj
    
    @classmethod
    def create_standard_alert_message(cls, camera_id, detections, camera_location="未指定", additional_data=None):
        """
        创建标准预警消息
        
        Args:
            camera_id (str): 摄像头ID
            detections (list): 检测对象列表
            camera_location (str): 摄像头位置
            additional_data (dict): 附加数据
            
        Returns:
            dict: 标准预警消息
        """
        # 生成全局消息
        if detections:
            messages = [det.get('message', det.get('description', det['class_name'])) for det in detections]
            global_message = f"检测到{len(detections)}个异常行为：" + "、".join(messages)
        else:
            global_message = "未检测到异常行为"
        
        # 获取当前时间戳
        current_time = time.time()
        timestamp_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        alert_message = {
            # 基础信息
            'camera_id': camera_id,
            'camera_location': camera_location,
            'alert_type': cls.ALERT_TYPES['SECURITY_DETECTION'],
            'timestamp': timestamp_str,  # 字符串格式时间戳
            'frame_timestamp': current_time,  # 浮点数时间戳
            'system_version': '1.0.0',
            
            # 检测信息
            'detections': detections,
            'total_detections': len(detections),
            'message': global_message,
            'confidence_threshold': 0.7  # 默认值，会在发送时更新为实际值
        }
        
        if additional_data:
            alert_message.update(additional_data)
            
        return alert_message
    
    def should_send_alert(self, class_name):
        """判断是否应该发送预警（冷却时间控制）"""
        # 只有异常行为才发送预警，正常行为不发送
        alert_classes = ['climb over', 'tailgating', 'carrybaby', 'Abnormal reverse', 'Reverse Tailgating', 'crawl']
        if class_name not in alert_classes:
            return False
        
        current_time = time.time()
        last_time = self.last_alert_time.get(class_name, 0)
        
        if current_time - last_time >= self.alert_cooldown:
            self.last_alert_time[class_name] = current_time
            return True
        
        return False
    
    def send_kafka_alert(self, detections, rgb_frame=None, ir_frame=None):
        """发送Kafka预警消息 - 使用标准化消息格式"""
        if not self.kafka_producer or not self.kafka_producer.is_connected:
            return False
        
        # 筛选需要预警的检测结果并转换为标准格式
        alert_detections = []
        for detection in detections:
            class_name = detection['class_name']
            if self.should_send_alert(class_name):
                # 创建裁剪图片
                detection_snapshot = None
                if rgb_frame is not None and ir_frame is not None:
                    detection_snapshot = self._create_detection_snapshot(
                        rgb_frame, ir_frame, detection['bbox'], class_name
                    )
                
                # 使用标准化方法创建检测对象
                standard_detection = self.create_standard_detection_object(
                    class_name=class_name,
                    confidence=detection['confidence'],
                    bbox=detection['bbox'],
                    additional_data={'detection_snapshot': detection_snapshot} if detection_snapshot else None
                )
                
                alert_detections.append(standard_detection)
        
        if not alert_detections:
            return False
        
        # 创建完整场景图片
        snapshot = None
        if rgb_frame is not None and ir_frame is not None:
            snapshot = self._create_full_scene_snapshot(rgb_frame, ir_frame, detections)
        
        # 使用标准化方法创建预警消息
        alert_message = self.create_standard_alert_message(
            camera_id=self.camera_id_var.get(),
            detections=alert_detections,
            camera_location=self.camera_location_var.get(),
            additional_data={
                'snapshot': snapshot,
                'confidence_threshold': self.confidence_var.get()  # 使用实际置信度值
            }
        )
        
        # 发送消息
        success = self.kafka_producer.send_alert(alert_message)
        
        if success:
            self.stats['kafka_sent'] += 1
            self.log_kafka_message(f"✅ 标准预警已发送: {alert_message['message']}")
        else:
            self.stats['kafka_failed'] += 1
            self.log_kafka_message(f"❌ 预警发送失败")
        
        return success
    
    def get_alert_level(self, class_name):
        """获取预警级别 - 使用标准化映射"""
        return self.CLASS_TO_ALERT_LEVEL.get(class_name, 'medium')
    
