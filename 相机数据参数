    def update_display_with_detections(self, rgb_frame, ir_frame, detections):
        """更新显示（带检测框）"""
        try:
            # 绘制检测框
            rgb_display = rgb_frame.copy()
            
            for detection in detections:
                if 'bbox' in detection:
                    bbox = detection['bbox']
                    class_name = detection['class_name']
                    confidence = detection['confidence']
                    
                    x1, y1, x2, y2 = map(int, bbox)
                    color = (0, 255, 0) if class_name == 'normal' else (0, 0, 255)
                    
                    cv2.rectangle(rgb_display, (x1, y1), (x2, y2), color, 2)
                    label = f"{class_name}: {confidence:.2f}"
                    cv2.putText(rgb_display, label, (x1, y1-10), 
                              cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)
            
            # 显示雷达预警
            if any(d['class_name'] == 'speed_violation' for d in detections):
                radar_alerts = [d for d in detections if d['class_name'] == 'speed_violation']
                y_offset = 30
                for alert in radar_alerts:
                    alert_text = f"⚠️ 雷达预警: {alert['description']}"
                    cv2.putText(rgb_display, alert_text, (10, y_offset), 
                              cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)
                    y_offset += 25
            
            # 调用原有的显示更新方法
            self.update_display(rgb_display, ir_frame, detections)
            
        except Exception as e:
            print(f"检测显示更新错误: {e}")
    

    def update_display(self, rgb_frame, ir_frame, detections):
        """更新显示"""
        try:
            # 动态计算显示尺寸，而不是硬编码350x250
            # 获取显示区域的实际尺寸
            try:
                # 尝试获取label的实际尺寸
                label_width = self.rgb_label.winfo_width()
                label_height = self.rgb_label.winfo_height()
                
                # 如果label还没有被渲染，使用默认尺寸
                if label_width <= 1 or label_height <= 1:
                    display_width, display_height = 350, 250
                else:
                    # 留出一些边距
                    display_width = max(200, min(600, label_width - 20))
                    display_height = max(150, min(450, label_height - 20))
            except:
                # 回退到默认尺寸
                display_width, display_height = 350, 250
            
            # 调整图像尺寸
            rgb_frame = cv2.resize(rgb_frame, (display_width, display_height))
            ir_frame = cv2.resize(ir_frame, (display_width, display_height))
            
            # 转换为RGB格式
            rgb_frame = cv2.cvtColor(rgb_frame, cv2.COLOR_BGR2RGB)
            ir_frame = cv2.cvtColor(ir_frame, cv2.COLOR_BGR2RGB)
            
            # 转换为PIL Image
            rgb_image = Image.fromarray(rgb_frame)
            ir_image = Image.fromarray(ir_frame)
            
            # 转换为PhotoImage
            rgb_photo = ImageTk.PhotoImage(rgb_image)
            ir_photo = ImageTk.PhotoImage(ir_image)
            
            # 更新显示
            self.rgb_label.configure(image=rgb_photo)
            self.rgb_label.image = rgb_photo
            
            self.ir_label.configure(image=ir_photo)
            self.ir_label.image = ir_photo
            
            # 更新统计信息
            self.update_stats()
            
            # 更新检测结果
            self.update_results(detections)
            
            # 更新雷达信息
            self.update_radar_display()
            
        except Exception as e:
            print(f"更新显示错误: {e}")
    

    
    
    
    def simple_buffer_clear(self, stream_type):
        """简单的缓冲区清空，专门处理POC错误"""
        try:
            cap = self.rgb_cap if stream_type == "RGB" else self.ir_cap
            if cap and cap.isOpened():
                # 快速读取几帧清空缓冲区，跳过损坏的帧
                for _ in range(5):
                    try:
                        ret, frame = cap.read()
                        if not ret:
                            break
                        # 如果读取成功，检查是否是有效帧
                        if frame is not None and frame.size > 0:
                            # 简单检查帧是否正常
                            if frame.shape[0] > 10 and frame.shape[1] > 10:
                                print(f"✅ {stream_type}获得有效帧，POC错误已跳过")
                                break
                    except:
                        continue
                print(f"✅ {stream_type}缓冲区已清空")
        except Exception as e:
            print(f"⚠️ {stream_type}缓冲区清空失败: {e}")
    

    

    

    
