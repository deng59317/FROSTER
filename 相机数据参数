    def get_ai_status(self):
        """获取AI状态（根据说明书完整格式）"""
        # 根据说明书，获取AI状态命令格式：A0 0F 05 00 00 00 00 00 00 00 00 02 00 E0 A0
        command = bytes.fromhex("A0 0F 05 00 00 00 00 00 00 00 00 02 00 E0 A0")
        
        if self.debug:
            print(f"🔧 构建获取AI状态命令:")
            print(f"   完整命令: {command.hex().upper()}")
        
        success, response, error = self.send_command(command, "获取AI状态")
        
        if success and response and len(response) >= 6:
            # 解析响应格式：FF F0 [状态码] [命令类型] [数据主体] ...
            if response[0] == 0xFF and response[1] == 0xF0:
                status_code = int.from_bytes(response[2:4], byteorder='little')
                if status_code == 0x0000:
                    # 查找AI状态数据（在响应中的位置可能不同）
                    if len(response) >= 7:
                        ai_status = response[6]  # 根据说明书示例，AI状态在第7个字节
                        if self.debug:
                            print(f"📊 AI状态解析: {ai_status:02X} ({'关闭' if ai_status == 0x01 else '开启'})")
                        return success, ai_status == 0x01, error  # True表示已关闭
        
        return success, None, error
    
    def verify_ai_status_after_set(self, expected_disabled=True, max_retries=3):
        """
        设置AI状态后验证是否成功
        
        Args:
            expected_disabled (bool): 期望的AI状态，True表示期望关闭
            max_retries (int): 最大重试次数
            
        Returns:
            bool: 验证是否成功
        """
        import time
        
        for retry in range(max_retries):
            try:
                # 等待摄像头处理完设置命令
                time.sleep(2.0)  # 等待2秒
                
                print(f"🔍 验证AI状态 (第{retry+1}次尝试)...")
                success, ai_disabled, error = self.get_ai_status()
                
                if success and ai_disabled is not None:
                    if ai_disabled == expected_disabled:
                        status_desc = "关闭" if ai_disabled else "开启"
                        print(f"✅ AI状态验证成功: {status_desc}")
                        return True
                    else:
                        actual_desc = "关闭" if ai_disabled else "开启"
                        expected_desc = "关闭" if expected_disabled else "开启"
                        print(f"⚠️ AI状态不符合预期: 实际={actual_desc}, 期望={expected_desc}")
                else:
                    print(f"⚠️ 无法获取AI状态: {error}")
                
                if retry < max_retries - 1:
                    print(f"⏳ 等待重试...")
                    time.sleep(1.0)
                    
            except Exception as e:
                print(f"❌ 验证AI状态异常: {e}")
        
        print(f"❌ AI状态验证失败，已重试{max_retries}次")
        return False


class RadarProcessor:
    """雷达数据处理器"""
    
    def __init__(self, port='COM3', baudrate=115200):
        self.port = port
        self.baudrate = baudrate
        self.ser = None
        self.is_running = False
        self.buffer = b''
        self.data_queue = queue.Queue()
        self.lock = threading.Lock()
        
    def calculate_checksum(self, data_bytes):
        return sum(data_bytes) & 0xFF
    
    def build_command(self, cmd_id, payload=b''):
        length = len(payload) + 1  # 加上 cmd_id 自身
        frame = RADAR_HEADER
        frame += struct.pack('<H', length)  # 数据长度
        frame += struct.pack('B', cmd_id)
        frame += payload
        checksum = self.calculate_checksum(frame[2:])
        frame += struct.pack('B', checksum)
        return frame
    
    def connect(self):
        """连接雷达设备"""
        try:
            self.ser = serial.Serial(self.port, self.baudrate, timeout=0.5)
            time.sleep(1)
            self.is_running = True
            
            # 发送开始上报命令
            cmd = self.build_command(CMD_START_REPORTING)
            self.ser.write(cmd)
            print(f"雷达已连接到 {self.port}")
            
            # 启动读取线程
            self.read_thread = threading.Thread(target=self.read_loop, daemon=True)
            self.read_thread.start()
            return True
            
        except Exception as e:
            print(f"雷达连接失败: {e}")
            return False
    
    def disconnect(self):
        """断开雷达连接"""
        self.is_running = False
        if self.ser and self.ser.is_open:
            try:
                # 发送停止上报命令
                cmd = self.build_command(CMD_STOP_REPORTING)
                self.ser.write(cmd)
            except:
                pass
            self.ser.close()
            print("雷达已断开")
    
    def parse_targets(self, data):
        """解析目标数据"""
        targets = []
        offset = 0
        
        while offset + TARGET_SIZE_BYTES <= len(data):
            tid = data[offset]  # 1 byte
            dist = struct.unpack('<H', data[offset+1:offset+3])[0] * 0.01
            speed = struct.unpack('<h', data[offset+3:offset+5])[0] * 0.01
            angle = struct.unpack('<h', data[offset+5:offset+7])[0] * 0.01
            snr = struct.unpack('<H', data[offset+7:offset+9])[0] * 0.01
            
            targets.append({
                "目标编号": tid,
                "距离(m)": dist,
                "速度(m/s)": speed,
                "方位角(°)": angle,
                "SNR(dB)": snr,
                "超速": abs(speed) > SPEED_THRESHOLD
            })
            offset += TARGET_SIZE_BYTES
        
        return targets
    
    def read_loop(self):
        """雷达数据读取循环"""
        while self.is_running:
            try:
                if self.ser.in_waiting > 0:
                    with self.lock:
                        self.buffer += self.ser.read(self.ser.in_waiting or 1)
                
                with self.lock:
                    while True:
                        start = self.buffer.find(RADAR_HEADER)
                        if start == -1 or len(self.buffer) < start + 5:
                            break
                        
                        length = struct.unpack('<H', self.buffer[start+2:start+4])[0]
                        total_len = 2 + 2 + length + 1  # header + length + data + checksum
                        
                        if len(self.buffer) < start + total_len:
                            break
                        
                        frame = self.buffer[start:start + total_len]
                        cmd_id = frame[4]
                        payload = frame[5:-1]
                        checksum = frame[-1]
                        
                        if self.calculate_checksum(frame[2:-1]) != checksum:
                            print("雷达数据校验失败")
                            self.buffer = self.buffer[start + 1:]
                            continue
                        
                        if cmd_id == CMD_TARGET_DATA:
                            targets = self.parse_targets(payload)
                            if targets:
                                self.data_queue.put({
                                    'timestamp': time.time(),
                                    'targets': targets
                                })
                        
                        self.buffer = self.buffer[start + total_len:]
                        
            except Exception as e:
                print(f"雷达读取错误: {e}")
                time.sleep(0.1)
    
    def get_latest_data(self):
        """获取最新的雷达数据"""
        latest_data = None
        try:
            # 获取队列中所有数据，保留最新的
            while not self.data_queue.empty():
                latest_data = self.data_queue.get_nowait()
        except:
            pass
        return latest_data


class KafkaAlertProducer:
    """Kafka预警消息生产者"""
    
    def __init__(self, bootstrap_servers='100.16.99.80:9092', topic='security_alerts'):
        self.topic = topic
        self.bootstrap_servers = bootstrap_servers
        self.producer = None
        self.is_connected = False
        
        if not KAFKA_AVAILABLE:
            print("Kafka库未安装，跳过Kafka初始化")
            return
            
        try:
            # SASL认证配置 - 使用正确的SCRAM配置
            sasl_config = {
                'bootstrap_servers': bootstrap_servers,
                'value_serializer': lambda v: json.dumps(v, ensure_ascii=False, default=str).encode('utf-8'),
                'key_serializer': lambda k: str(k).encode('utf-8') if k else None,
                'acks': 'all',
                'retries': 3,
                'batch_size': 16384,
                'linger_ms': 10,
                'buffer_memory': 33554432,
                # 连接和超时配置
                'request_timeout_ms': 30000,
                'connections_max_idle_ms': 300000,
                'metadata_max_age_ms': 300000,
                # SASL SCRAM-SHA-256认证参数（完整配置）
                'security_protocol': 'SASL_PLAINTEXT',
                'sasl_mechanism': 'SCRAM-SHA-256',
                'sasl_plain_username': 'admin',
                'sasl_plain_password': 'admin@2021',
                # 等价于Java的sasl_jaas_config配置
                'sasl_kerberos_service_name': None,  # 明确禁用Kerberos
            }
            
            self.producer = KafkaProducer(**sasl_config)
            self.is_connected = True
            print(f"Kafka生产者已连接到 {bootstrap_servers}, 主题: {topic} (SCRAM-SHA-256认证)")
        except Exception as e:
            print(f"Kafka连接失败: {e}")
            self.is_connected = False
    
    def send_alert(self, alert_data):
        """发送预警消息"""
        if not self.is_connected or not self.producer:
            return False
        
        try:
            # 添加时间戳
            alert_data['timestamp'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
            alert_data['system_version'] = '1.0.0'
            
            # 发送消息
            future = self.producer.send(
                self.topic,
                value=alert_data,
                key=f"alert_{alert_data.get('camera_id', 'unknown')}_{int(time.time())}"
            )
            
            # 等待发送结果
            record_metadata = future.get(timeout=10)
            print(f"✅ Kafka消息已发送到主题 {record_metadata.topic}, 分区 {record_metadata.partition}")
            return True
            
        except Exception as e:
            print(f"❌ Kafka发送失败: {e}")
            return False
    
    def close(self):
        """关闭Kafka生产者"""
        if self.producer:
            self.producer.close()
            print("Kafka生产者已关闭")


