class RTSCapture(cv2.VideoCapture):
    """
    优化的RTSP流捕获类，解决延迟和花屏问题
    通过多线程实时读取最新帧，避免OpenCV内置缓存导致的延迟
    """
    
    def __init__(self, url, *args, **kwargs):
        schemes = ["rtsp://", "rtmp://", "http://", "https://"]
        if isinstance(url, str) and any(url.startswith(scheme) for scheme in schemes):
            super().__init__(url, cv2.CAP_FFMPEG, *args, **kwargs)
        else:
            super().__init__(url, *args, **kwargs)
        self._cur_frame = None
        self._reading = False
        self._frame_lock = threading.Lock()  # 添加线程锁保护
        self.schemes = ["rtsp://", "rtmp://", "http://", "https://"]
        self.frame_receiver = None
        self._last_frame_time = 0
        self._fps_counter = 0
        self._last_fps_time = time.time()
        self._actual_fps = 0.0
        
        # 配置RTSP参数以减少延迟
        if isinstance(url, str) and any(url.startswith(scheme) for scheme in self.schemes):
            self._reading = True
            self._setup_rtsp_optimization()
    
    def _setup_rtsp_optimization(self):
        """设置RTSP优化参数，充分利用CPU多线程解码"""
        try:
            import multiprocessing
            cpu_count = multiprocessing.cpu_count()
            print(f"🔧 检测到CPU核心数: {cpu_count}")
            
            # 后端已在 __init__ 中设置，此处无需重复操作
            
            # 设置最小缓冲区大小，避免累积延迟
            self.set(cv2.CAP_PROP_BUFFERSIZE, 1)
            
            # 设置超时参数
            self.set(cv2.CAP_PROP_OPEN_TIMEOUT_MSEC, 15000)  # 15秒连接超时
            self.set(cv2.CAP_PROP_READ_TIMEOUT_MSEC, 8000)   # 8秒读取超时
            
            # 强制使用H.264解码器，避免HEVC POC错误
            self.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc('H', '2', '6', '4'))
            
            # 尝试设置多线程解码参数
            try:
                # 设置解码线程数为CPU核心数
                self.set(cv2.CAP_PROP_FRAME_COUNT, cpu_count)  # 使用帧计数属性设置线程
                print(f"✅ 设置解码线程数: {cpu_count}")
            except Exception as thread_err:
                print(f"⚠️ 无法设置解码线程数: {thread_err}")
            
            # 设置像素格式，优化解码性能
            try:
                self.set(cv2.CAP_PROP_CONVERT_RGB, 1)  # 自动转换RGB
                print("✅ 设置像素格式优化")
            except Exception as fmt_err:
                print(f"⚠️ 像素格式设置失败: {fmt_err}")
            
            # 设置网络传输优化
            try:
                self.set(cv2.CAP_PROP_POS_MSEC, 0)  # 重置时间戳
                print("✅ 网络传输优化设置完成")
            except Exception as net_err:
                print(f"⚠️ 网络优化失败: {net_err}")
            
            print("✅ RTSCapture多线程RTSP优化参数已设置")
            
        except Exception as e:
            print(f"❌ RTSCapture优化参数设置失败: {e}")
    
    @staticmethod
    def create(url, *schemes):
        """创建RTSCapture实例的工厂方法"""
        rtscap = RTSCapture(url)
        rtscap.schemes.extend(schemes)
        
        if isinstance(url, str) and url.startswith(tuple(rtscap.schemes)):
            rtscap.frame_receiver = threading.Thread(target=rtscap.recv_frame, daemon=True)
            rtscap._reading = True
        elif isinstance(url, int):
            # 本地摄像头，不需要特殊处理
            rtscap._reading = False
        
        return rtscap
    
    def isStarted(self):
        """检查捕获是否已启动"""
        ok = self.isOpened()
        if ok and self._reading and self.frame_receiver:
            ok = self.frame_receiver.is_alive()
        return ok
    
    def recv_frame(self):
        """后台线程持续读取最新帧 - 多线程优化版本"""
        consecutive_errors = 0
        max_errors = 15  # 增加容错次数
        frame_skip_count = 0  # 跳帧计数
        
        # 设置线程优先级（Windows和Linux兼容）
        try:
            import os
            if hasattr(os, 'nice'):
                os.nice(-5)  # 提高线程优先级（Linux）
        except:
            pass
        
        print("🚀 RTSCapture多线程后台读取启动")
        
        while self._reading and self.isOpened():
            try:
                # 使用非阻塞读取策略
                ok, frame = super().read()  # 调用父类的read方法
                
                if not ok or frame is None:
                    consecutive_errors += 1
                    if consecutive_errors >= max_errors:
                        print(f"❌ RTSCapture连续{consecutive_errors}次读取失败，停止线程")
                        break
                    
                    # 根据错误次数调整等待时间
                    if consecutive_errors < 5:
                        time.sleep(0.001)  # 短错误，快速重试
                    else:
                        time.sleep(0.005)  # 多次错误，稍长等待
                    continue
                
                # 重置错误计数
                consecutive_errors = 0
                
                # 快速帧质量验证，减少CPU开销
                if self._validate_frame_fast(frame):
                    frame_skip_count = 0  # 重置跳帧计数
                    
                    # 使用最小锁定时间更新帧
                    with self._frame_lock:
                        self._cur_frame = frame
                        self._last_frame_time = time.time()
                        self._fps_counter += 1
                    
                    # 计算实际FPS（降低计算频率）
                    current_time = time.time()
                    if current_time - self._last_fps_time >= 2.0:  # 每2秒计算一次
                        self._actual_fps = self._fps_counter / (current_time - self._last_fps_time)
                        self._fps_counter = 0
                        self._last_fps_time = current_time
                        
                        # 输出多线程解码状态
                        if self._actual_fps > 0:
                            print(f"🎯 RTSCapture多线程解码FPS: {self._actual_fps:.1f}")
                else:
                    # 处理损坏帧
                    frame_skip_count += 1
                    if frame_skip_count > 50:  # 连续50帧损坏，可能是POC错误
                        print(f"⚠️ 检测到连续{frame_skip_count}帧损坏，可能是POC错误，尝试重新同步...")
                        # 快速跳过多个帧以重新同步
                        for _ in range(5):
                            try:
                                super().read()
                            except:
                                break
                        frame_skip_count = 0
                
                # 根据CPU负载动态调整延迟
                # 多核CPU下可以更积极地读取
                import multiprocessing
                if multiprocessing.cpu_count() >= 8:
                    time.sleep(0.0005)  # 8核以上，极小延迟
                elif multiprocessing.cpu_count() >= 4:
                    time.sleep(0.001)   # 4-7核，小延迟
                else:
                    time.sleep(0.002)   # 少于4核，稍大延迟
                
            except Exception as e:
                consecutive_errors += 1
                if "POC" in str(e) or "ref" in str(e):
                    print(f"🔧 检测到POC错误，自动恢复中...")
                    # POC错误恢复策略：快速跳过损坏帧
                    for _ in range(10):
                        try:
                            super().read()  # 快速跳过损坏帧
                        except:
                            break
                    consecutive_errors = max(0, consecutive_errors - 5)  # 减少错误计数
                else:
                    print(f"⚠️ RTSCapture帧读取异常: {e}")
                
                if consecutive_errors >= max_errors:
                    print(f"❌ RTSCapture达到最大错误次数，停止线程")
                    break
                    
                # 错误恢复等待
                time.sleep(0.01 if consecutive_errors < 10 else 0.05)
        
        self._reading = False
        print("🔄 RTSCapture多线程后台线程结束")
    
    def _validate_frame(self, frame):
        """验证帧质量，检测花屏"""
        if frame is None or frame.size == 0:
            return False
        
        try:
            # 检查基本尺寸
            height, width = frame.shape[:2]
            if height < 10 or width < 10:
                return False
            
            # 检查灰度方差，过低可能是花屏或纯色
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            variance = np.var(gray)
            
            # 方差过低可能是花屏
            if variance < 1.0:
                return False
            
            # 检查亮度分布，避免过度曝光或全黑
            mean_brightness = np.mean(gray)
            if mean_brightness < 5 or mean_brightness > 250:
                return False
            
            return True
            
        except Exception:
            return False
    
    def _validate_frame_fast(self, frame):
        """快速帧验证，减少CPU开销"""
        if frame is None or frame.size == 0:
            return False
        
        try:
            # 只检查基本尺寸和数据完整性
            height, width = frame.shape[:2]
            if height < 10 or width < 10:
                return False
            
            # 快速检查：采样几个像素点验证数据完整性
            # 避免全帧处理，减少CPU负担
            if height > 100 and width > 100:
                # 检查4个角落的像素值
                corners = [
                    frame[10, 10],
                    frame[10, width-10],
                    frame[height-10, 10],
                    frame[height-10, width-10]
                ]
                
                # 检查角落像素是否全为0（可能的损坏帧特征）
                all_zero = all(np.all(corner == 0) for corner in corners)
                if all_zero:
                    return False
                
                # 检查是否有极端异常值
                all_max = all(np.all(corner == 255) for corner in corners)
                if all_max:
                    return False
            
            return True
            
        except Exception:
            return False
    
    def read_latest_frame(self):
        """读取最新帧（非阻塞）"""
        if not self._reading:
            # 非RTSP流，使用标准read方法
            return super().read()
        
        with self._frame_lock:
            if self._cur_frame is not None:
                frame = self._cur_frame.copy()
                return True, frame
            else:
                return False, None
    
    def read2(self):
        """替代read方法，返回最新帧并清空缓存"""
        if not self._reading:
            return super().read()
        
        with self._frame_lock:
            frame = self._cur_frame
            self._cur_frame = None  # 清空缓存，确保下次读取新帧
            return frame is not None, frame
    
    def start_read(self):
        """启动帧读取"""
        if self._reading and self.frame_receiver:
            self.frame_receiver.start()
            # 设置读取方法
            self.read_latest_frame = self.read2 if self._reading else super().read
            print("✅ RTSCapture已启动多线程读取")
        else:
            # 非RTSP流，使用标准读取
            self.read_latest_frame = super().read
            print("✅ RTSCapture使用标准读取模式")
    
    def stop_read(self):
        """停止帧读取"""
        self._reading = False
        if self.frame_receiver and self.frame_receiver.is_alive():
            try:
                self.frame_receiver.join(timeout=3.0)  # 最多等待3秒
                print("✅ RTSCapture后台线程已停止")
            except Exception as e:
                print(f"⚠️ RTSCapture线程停止异常: {e}")
    
    def get_fps(self):
        """获取实际FPS"""
        return self._actual_fps
    
    def get_frame_age(self):
        """获取当前帧的年龄（秒）"""
        if self._last_frame_time > 0:
            return time.time() - self._last_frame_time
        return float('inf')
    
    def release(self):
        """释放资源"""
        self.stop_read()
        super().release()


