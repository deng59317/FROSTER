    def process_batch_optimized(self, rgb_batch, ir_batch, original_frames):
        """优化的批处理推理 - 简化版本，减少开销"""
        try:
            # 获取雷达数据
            radar_alerts = []
            if self.radar_enabled and self.radar_processor:
                radar_data = self.radar_processor.get_latest_data()
                if radar_data:
                    self.last_radar_data = radar_data
                    for target in radar_data['targets']:
                        if target['超速']:
                            radar_alert = {
                                'class_name': 'speed_violation',
                                'confidence': 1.0,
                                'radar_data': target,
                                'description': f"目标{target['目标编号']}超速: {target['速度(m/s)']:.2f}m/s"
                            }
                            radar_alerts.append(radar_alert)
            
            # 强制使用批处理推理
            if rgb_batch and ir_batch and len(rgb_batch) == len(ir_batch):
                all_detections_batch = []
                batch_size = len(rgb_batch)
                
                # 直接进行批处理推理，减少日志输出
                try:
                    # 确保预测器有批处理方法
                    if hasattr(self.predictor, 'predict_batch'):
                        batch_results = self.predictor.predict_batch(
                            rgb_batch, ir_batch,
                            conf_threshold=self.confidence_var.get(),
                            iou_threshold=0.45
                        )
                        
                        # 快速处理批处理结果
                        for i, (results, original_rgb, original_ir) in enumerate(zip(batch_results, rgb_batch, ir_batch)):
                            detections = []
                            
                            # 处理检测结果
                            if results and results.boxes is not None:
                                boxes = results.boxes.cpu().numpy()
                                
                                for box in boxes:
                                    x1, y1, x2, y2 = box.xyxy[0]
                                    
                                    # 确保坐标在图像范围内
                                    original_h, original_w = original_rgb.shape[:2]
                                    x1_final = max(0, min(original_w, int(x1)))
                                    y1_final = max(0, min(original_h, int(y1)))
                                    x2_final = max(0, min(original_w, int(x2)))
                                    y2_final = max(0, min(original_h, int(y2)))
                                    
                                    detection = {
                                        'class_name': results.names[int(box.cls[0])],
                                        'confidence': float(box.conf[0]),
                                        'bbox': [x1_final, y1_final, x2_final, y2_final]
                                    }
                                    detections.append(detection)
                                
                                self.stats['detection_count'] += len(detections)
                            
                            # 合并雷达预警
                            frame_detections = detections + radar_alerts
                            all_detections_batch.append((frame_detections, original_rgb, original_ir))
                        
                    else:
                        # 快速单帧处理
                        for i, (rgb_frame, ir_frame) in enumerate(zip(rgb_batch, ir_batch)):
                            detections = []
                            try:
                                results = self.predictor.predict_frame(
                                    rgb_frame, ir_frame,
                                    conf_threshold=self.confidence_var.get(),
                                    iou_threshold=0.45
                                )
                                
                                if results and results.boxes is not None:
                                    boxes = results.boxes.cpu().numpy()
                                    
                                    for box in boxes:
                                        x1, y1, x2, y2 = box.xyxy[0]
                                        
                                        original_h, original_w = rgb_frame.shape[:2]
                                        x1_final = max(0, min(original_w, int(x1)))
                                        y1_final = max(0, min(original_h, int(y1)))
                                        x2_final = max(0, min(original_w, int(x2)))
                                        y2_final = max(0, min(original_h, int(y2)))
                                        
                                        detection = {
                                            'class_name': results.names[int(box.cls[0])],
                                            'confidence': float(box.conf[0]),
                                            'bbox': [x1_final, y1_final, x2_final, y2_final]
                                        }
                                        detections.append(detection)
                                    
                                    self.stats['detection_count'] += len(detections)
                                    
                            except Exception as e:
                                pass  # 静默处理单帧异常
                            
                            # 合并雷达预警
                            frame_detections = detections + radar_alerts
                            all_detections_batch.append((frame_detections, rgb_frame, ir_frame))
                
                except Exception as e:
                    print(f"❌ 批处理推理失败: {e}")
                    return
                
                # 快速处理结果 - 只发送第一个有检测的帧的预警
                alert_sent = False
                for detections, original_rgb, original_ir in all_detections_batch:
                    if detections and not alert_sent:
                        try:
                            success = self.send_kafka_alert(detections, original_rgb, original_ir)
                            if success:
                                alert_sent = True
                        except Exception as e:
                            pass  # 静默处理Kafka异常
                
                # 只更新最后一帧的显示
                if all_detections_batch:
                    last_detections, last_rgb, last_ir = all_detections_batch[-1]
                    self.root.after(0, self.update_display_with_detections, last_rgb, last_ir, last_detections)
                
                # 雷达预警统计
                if radar_alerts:
                    self.stats['radar_alert_count'] += len(radar_alerts)
                
        except Exception as e:
            print(f"批处理异常: {e}")
    
