                            messagebox.showwarning("警告", "AI启用命令已发送，但状态验证失败")
                    else:
                        messagebox.showerror("错误", f"启用摄像头AI失败: {error}")
                else:
                    # 关闭AI
                    success, response, error = self.camera_ai_controller.disable_ai()
                    if success:
                        self.camera_ai_status_var.set("AI关闭命令已发送")
                        self.camera_ai_status_label.configure(foreground="blue")
                        
                        # 验证AI状态
                        verification_success = self.camera_ai_controller.verify_ai_status_after_set(expected_disabled=True)
                        if verification_success:
                            self.camera_ai_enabled_var.set(False)
                            self.camera_ai_status_var.set("AI已关闭")
                            self.camera_ai_status_label.configure(foreground="green")
                            self.camera_ai_button.configure(text="启用摄像头AI")
                            self.camera_ai_disabled = True
                            messagebox.showinfo("成功", "摄像头AI功能已关闭")
                        else:
