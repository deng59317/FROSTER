            self.rgb_cap = RTSCapture.create(rgb_source)
            self.ir_cap = RTSCapture.create(ir_source)
            
            # 优化RTSP流设置 - 网络缓冲机制 + GPU硬件加速
            if isinstance(rgb_source, str) and rgb_source.startswith('rtsp://'):
                # GPU硬件加速解码设置
                try:
                    # 后端已在RTSCapture的__init__中设置
                    
                    # 启用GPU硬件加速解码
                    if self.device != "cpu":
                        try:
                            # 尝试NVIDIA GPU硬件解码
                            self.rgb_cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc('H', '2', '6', '4'))
                            # 启用硬件加速
                            self.rgb_cap.set(cv2.CAP_PROP_HW_ACCELERATION, cv2.VIDEO_ACCELERATION_ANY)
                            self.rgb_cap.set(cv2.CAP_PROP_HW_DEVICE, 0)  # 使用第一个GPU设备
                            print("✅ RGB流已启用GPU硬件加速解码")
                        except:
                            # 回退到CPU解码
                            self.rgb_cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc('H', '2', '6', '4'))
                            print("⚠️ RGB流回退到CPU解码")
                    else:
                        # CPU模式
                        self.rgb_cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc('H', '2', '6', '4'))
                        print("✅ RGB流使用CPU解码")
                        
                except Exception as e:
                    print(f"⚠️ RGB解码器设置失败: {e}")
                
                # 网络缓冲机制 - 100ms缓冲
                try:
                    # 计算100ms对应的帧数 (假设25fps)
                    fps = 25
                    buffer_ms = self.buffer_time_var.get()
                    buffer_frames = max(2, int(fps * (buffer_ms / 1000.0)))
                    self.rgb_cap.set(cv2.CAP_PROP_BUFFERSIZE, buffer_frames)
                    print(f"✅ RGB网络缓冲设置为{buffer_frames}帧({buffer_ms}ms@{fps}fps)")
                except Exception as e:
                    print(f"⚠️ RGB缓冲区设置失败: {e}")
                
                # 设置分辨率和帧率
                try:
                    self.rgb_cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
                    self.rgb_cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
                    self.rgb_cap.set(cv2.CAP_PROP_FPS, 25)
                    print("✅ RGB流设置为1280x720@25fps")
                except:
                    print("⚠️ 使用RGB流默认参数")
                
                # 网络优化参数
                try:
                    self.rgb_cap.set(cv2.CAP_PROP_OPEN_TIMEOUT_MSEC, 15000)  # 15秒连接超时
                    self.rgb_cap.set(cv2.CAP_PROP_READ_TIMEOUT_MSEC, 8000)   # 8秒读取超时
                    # 启用网络优化
                    print("✅ RGB网络参数已优化")
                except:
                    print("⚠️ 无法设置RGB网络参数")
                
            if isinstance(ir_source, str) and ir_source.startswith('rtsp://'):
                # GPU硬件加速解码设置
                try:
                    # 后端已在RTSCapture的__init__中设置
                    
                    # 启用GPU硬件加速解码
                    if self.device != "cpu":
                        try:
                            # 尝试NVIDIA GPU硬件解码
                            self.ir_cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc('H', '2', '6', '4'))
                            # 启用硬件加速
                            self.ir_cap.set(cv2.CAP_PROP_HW_ACCELERATION, cv2.VIDEO_ACCELERATION_ANY)
                            self.ir_cap.set(cv2.CAP_PROP_HW_DEVICE, 0)  # 使用第一个GPU设备
                            print("✅ IR流已启用GPU硬件加速解码")
                        except:
                            # 回退到CPU解码
                            self.ir_cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc('H', '2', '6', '4'))
                            print("⚠️ IR流回退到CPU解码")
                    else:
                        # CPU模式
                        self.ir_cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc('H', '2', '6', '4'))
                        print("✅ IR流使用CPU解码")
                        
                except Exception as e:
                    print(f"⚠️ IR解码器设置失败: {e}")
                
                # 网络缓冲机制 - 100ms缓冲
                try:
                    # 计算100ms对应的帧数 (假设25fps)
                    fps = 25
                    buffer_ms = self.buffer_time_var.get()
                    buffer_frames = max(2, int(fps * (buffer_ms / 1000.0)))
                    self.ir_cap.set(cv2.CAP_PROP_BUFFERSIZE, buffer_frames)
                    print(f"✅ IR网络缓冲设置为{buffer_frames}帧({buffer_ms}ms@{fps}fps)")
                except Exception as e:
                    print(f"⚠️ IR缓冲区设置失败: {e}")
                
                # 设置分辨率和帧率
                try:
                    self.ir_cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
                    self.ir_cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
                    self.ir_cap.set(cv2.CAP_PROP_FPS, 25)
                    print("✅ IR流设置为1280x720@25fps")
                except:
                    print("⚠️ 使用IR流默认参数")
                
                # 网络优化参数
                try:
                    self.ir_cap.set(cv2.CAP_PROP_OPEN_TIMEOUT_MSEC, 15000)  # 15秒连接超时
                    self.ir_cap.set(cv2.CAP_PROP_READ_TIMEOUT_MSEC, 8000)   # 8秒读取超时
                    # 启用网络优化
                    print("✅ IR网络参数已优化")
                except:
                    print("⚠️ 无法设置IR网络参数")
            
            if not self.rgb_cap.isOpened() or not self.ir_cap.isOpened():
                error_msg = "无法连接视频流！\n"
                if not self.rgb_cap.isOpened():
                    error_msg += f"RGB流连接失败: {rgb_source}\n"
                if not self.ir_cap.isOpened():
                    error_msg += f"IR流连接失败: {ir_source}\n"
                error_msg += "请检查RTSP URL和网络连接。"
                messagebox.showerror("错误", error_msg)
                return
            
            # 启动RTSCapture的多线程读取
            print("🚀 启动RTSCapture多线程读取...")
            self.rgb_cap.start_read()
            self.ir_cap.start_read()
            
            # 等待后台线程启动
            time.sleep(1)
            
            # 测试读取帧，允许多次重试
            rgb_frame_success = False
            ir_frame_success = False
            max_retries = 5
            
            for retry in range(max_retries):
                if not rgb_frame_success:
                    ret_rgb, frame_rgb = self.rgb_cap.read_latest_frame()
                    if ret_rgb and frame_rgb is not None:
                        rgb_frame_success = True
                        print(f"RGB流读取成功 (重试 {retry + 1}/{max_retries}) - RTSCapture")
                
                if not ir_frame_success:
                    ret_ir, frame_ir = self.ir_cap.read_latest_frame()
                    if ret_ir and frame_ir is not None:
                        ir_frame_success = True
                        print(f"IR流读取成功 (重试 {retry + 1}/{max_retries}) - RTSCapture")
                
                if rgb_frame_success and ir_frame_success:
                    break
                
                if retry < max_retries - 1:
                    print(f"帧读取失败，正在重试... ({retry + 1}/{max_retries})")
                    time.sleep(1)  # 等待1秒后重试
            
            if not rgb_frame_success or not ir_frame_success:
                error_msg = "视频流连接成功但无法读取帧！\n"
                if not rgb_frame_success:
                    error_msg += f"RGB流无法读取: {rgb_source}\n"
                if not ir_frame_success:
                    error_msg += f"IR流无法读取: {ir_source}\n"
                error_msg += "可能是网络不稳定或视频编码问题。"
                messagebox.showerror("错误", error_msg)
                return
            
            # 更新连接状态
            self.connection_status_var.set("视频流已连接")
            self.connection_status_label.configure(foreground="green")
            
            # 启动检测
            self.is_running = True
            self.stats['start_time'] = time.time()
            self.stats['frame_count'] = 0
            self.stats['detection_count'] = 0
            self.stats['alert_count'] = 0
            self.stats['radar_alert_count'] = 0
            self.stats['kafka_sent'] = 0
            self.stats['kafka_failed'] = 0
            
            # 重置帧率统计
            self.rgb_fps = 0.0
            self.ir_fps = 0.0
            self.processed_fps = 0.0
            
            # 更新按钮状态
            self.start_button.config(state=tk.DISABLED)
            self.stop_button.config(state=tk.NORMAL)
            self.save_button.config(state=tk.NORMAL)
            self.reconnect_button.config(state=tk.NORMAL)
            
            # 初始化HEVC错误计数器
            self.hevc_error_count = 0
            self.rgb_hevc_errors = 0
            self.ir_hevc_errors = 0
            
            # 简化的预防性HEVC禁用
            print("🛡️ 执行基础HEVC禁用...")
            self.force_disable_hevc_decoder()
            
            # 启动检测线程
            self.detection_thread = threading.Thread(target=self.detection_loop, daemon=True)
            self.detection_thread.start()
            
            self.status_var.set("检测中...")
            
        except Exception as e:
            messagebox.showerror("错误", f"启动检测失败: {e}")
            self.stop_detection()
    
    def stop_detection(self):
        """停止检测"""
        self.is_running = False
        
        # 释放资源
        if self.rgb_cap:
            self.rgb_cap.release()
            self.rgb_cap = None
        
        if self.ir_cap:
            self.ir_cap.release()
            self.ir_cap = None
        
        # 断开雷达连接
        if self.radar_processor:
            self.radar_processor.disconnect()
            self.radar_processor = None
            self.radar_enabled = False
            self.radar_status_var.set("已断开")
            self.radar_status_label.configure(foreground="red")
        
        # 关闭Kafka生产者
        if self.kafka_producer:
            self.kafka_producer.close()
            self.kafka_producer = None
            self.kafka_status_var.set("已断开")
            self.kafka_status_label.configure(foreground="red")
        
        # 更新按钮状态
        self.start_button.config(state=tk.NORMAL)
        self.stop_button.config(state=tk.DISABLED)
        self.save_button.config(state=tk.DISABLED)
        self.reconnect_button.config(state=tk.DISABLED)
        
        # 更新连接状态
        self.connection_status_var.set("已断开")
        self.connection_status_label.configure(foreground="red")
        
        # 重置处理模式状态 - 独立处理模式
        self.alignment_status_var.set("独立处理模式")
        self.alignment_status_label.configure(foreground="gray")
        
        # 重置帧率统计
        self.rgb_fps = 0.0
        self.ir_fps = 0.0
        self.processed_fps = 0.0
        
        # 重置HEVC错误计数器
        self.hevc_error_count = 0
        
        self.status_var.set("已停止")
    
    def detection_loop(self):
        """检测循环 - 使用配置文件的ultra_fast模式"""
        consecutive_errors = 0
        max_consecutive_errors = 20
        
        # 从配置文件获取批处理参数
        batch_size = BATCH_CONFIG["batch_size"]
        max_batch_size = BATCH_CONFIG["max_batch_size"]
        batch_interval = BATCH_CONFIG["batch_interval"]
        max_wait_time = BATCH_CONFIG["max_wait_time"]
        force_timeout = BATCH_CONFIG["force_timeout"]
        min_batch_trigger = BATCH_CONFIG["min_batch_trigger"]
        enable_fast_mode = BATCH_CONFIG["enable_fast_mode"]
        
        # 批处理缓冲区
        rgb_batch = []
        ir_batch = []
        original_frames = []
        
        # 帧率统计
        rgb_fps_counter = 0
        ir_fps_counter = 0
        last_fps_time = time.time()
        last_batch_process_time = time.time()
        
        # 记录最后有效帧，避免画面切换
        last_valid_rgb = None
        last_valid_ir = None
        
        # 性能监控
        batch_count = 0
        total_batch_time = 0
        display_update_counter = 0
        
        print(f"🚀 Ultra Fast批处理启动:")
        print(f"   批处理大小: {batch_size} (最大: {max_batch_size})")
        print(f"   时间参数: 间隔={batch_interval*1000:.1f}ms, 等待={max_wait_time*1000:.1f}ms")
        print(f"   快速模式: {enable_fast_mode}")
        
        while self.is_running:
            try:
                current_time = time.time()
                
                # 独立读取RGB和IR帧
                rgb_frame = None
                ir_frame = None
                
                # 快速读取RGB帧 - 使用RTSCapture优化读取
                try:
                    ret_rgb, rgb_frame = self.rgb_cap.read_latest_frame()
                    if ret_rgb and rgb_frame is not None and rgb_frame.size > 0:
                        # 180度翻转RGB帧
                        rgb_frame = cv2.rotate(rgb_frame, cv2.ROTATE_180)
                        
                        # 简化验证，只做基本检查
                        if rgb_frame.shape[0] > 10 and rgb_frame.shape[1] > 10:
                            # 只进行最基础的质量检查，避免误判
                            gray = cv2.cvtColor(rgb_frame, cv2.COLOR_BGR2GRAY)
                            variance = np.var(gray)
                            
                            # 只有在方差极低时才认为是解码错误
                            if variance > 0.1:  # 大大放宽标准
                                rgb_fps_counter += 1
                                last_valid_rgb = rgb_frame
                            else:
                                # 仅在极端情况下才认为是错误
                                if not hasattr(self, 'rgb_hevc_errors'):
                                    self.rgb_hevc_errors = 0
                                self.rgb_hevc_errors += 1
                                self.hevc_error_count += 1
                                
                                # 提高触发阈值，减少误触发
                                if self.rgb_hevc_errors >= 20:  # 从5改为20
                                    print(f"🔄 RGB流严重解码错误，清空缓冲区...")
                                    self.simple_buffer_clear("RGB")
                                    self.rgb_hevc_errors = 0
                                
                                rgb_frame = None
                        else:
                            rgb_frame = None
                except Exception as e:
                    rgb_frame = None
                    # 如果连续失败，尝试跳过几帧
                    if consecutive_errors > 10:  # 提高阈值
                        try:
                            for _ in range(3):
                                self.rgb_cap.read_latest_frame()
                        except:
                            pass
                
                # 快速读取IR帧 - 使用RTSCapture优化读取
                try:
                    ret_ir, ir_frame = self.ir_cap.read_latest_frame()
                    if ret_ir and ir_frame is not None and ir_frame.size > 0:
                        # 180度翻转IR帧
                        ir_frame = cv2.rotate(ir_frame, cv2.ROTATE_180)
                        
                        # 简化验证，只做基本检查
                        if ir_frame.shape[0] > 10 and ir_frame.shape[1] > 10:
                            # 只进行最基础的质量检查，避免误判
                            gray = cv2.cvtColor(ir_frame, cv2.COLOR_BGR2GRAY)
                            variance = np.var(gray)
                            
                            # 只有在方差极低时才认为是解码错误
                            if variance > 0.1:  # 大大放宽标准
                                ir_fps_counter += 1
                                last_valid_ir = ir_frame
                            else:
                                # 仅在极端情况下才认为是错误
                                if not hasattr(self, 'ir_hevc_errors'):
                                    self.ir_hevc_errors = 0
                                self.ir_hevc_errors += 1
                                self.hevc_error_count += 1
                                
                                # 提高触发阈值，减少误触发
                                if self.ir_hevc_errors >= 20:  # 从5改为20
                                    print(f"🔄 IR流严重解码错误，清空缓冲区...")
                                    self.simple_buffer_clear("IR")
                                    self.ir_hevc_errors = 0
                                
                                ir_frame = None
                        else:
                            ir_frame = None
                except Exception as e:
                    ir_frame = None
                    # 如果连续失败，尝试跳过几帧
                    if consecutive_errors > 10:  # 提高阈值
                        try:
                            for _ in range(3):
                                self.ir_cap.read_latest_frame()
                        except:
                            pass
                
                # 帧处理逻辑 - 修复画面切换问题
                process_frame = False
                final_rgb = None
                final_ir = None
                
                if rgb_frame is not None and ir_frame is not None:
                    # 双帧都有效，直接使用
                    final_rgb = rgb_frame
                    final_ir = ir_frame
                    process_frame = True
                elif rgb_frame is not None and last_valid_ir is not None:
                    # 只有RGB帧，使用最后有效的IR帧
                    final_rgb = rgb_frame
                    final_ir = last_valid_ir
                    process_frame = True
                elif ir_frame is not None and last_valid_rgb is not None:
                    # 只有IR帧，使用最后有效的RGB帧
                    final_rgb = last_valid_rgb
                    final_ir = ir_frame
                    process_frame = True
                elif last_valid_rgb is not None and last_valid_ir is not None:
                    # 都没有新帧，但有历史帧，偶尔处理以保持显示
                    if len(rgb_batch) == 0 and current_time - last_batch_process_time > 0.2:
                        final_rgb = last_valid_rgb
                        final_ir = last_valid_ir
                        process_frame = True
                
                if process_frame and final_rgb is not None and final_ir is not None:
                    # 重置错误计数
                    consecutive_errors = 0
                    
                    try:
                        # 保持原生分辨率，不进行对齐
                        original_rgb = final_rgb.copy()
                        original_ir = final_ir.copy()
                        
                        # 添加到批处理 - RGB和IR独立处理
                        rgb_batch.append(original_rgb)
                        ir_batch.append(original_ir)
                        frame_info = {
                            'original_rgb': original_rgb,
                            'original_ir': original_ir,
                            'rgb_size': original_rgb.shape[:2],  # 记录原始尺寸
                            'ir_size': original_ir.shape[:2],    # 记录原始尺寸
                        }
                        original_frames.append(frame_info)
                        
                        self.stats['frame_count'] += 1
                        
                    except Exception as e:
                        if not enable_fast_mode:
                            print(f"帧预处理异常: {e}")
                        continue
                
                # 优化的批处理触发逻辑 - 提升帧率
                time_since_last_batch = current_time - last_batch_process_time
                
                # 更激进的触发条件，减少等待时间
                should_process_batch = (
                    len(rgb_batch) >= batch_size or  # 达到目标批处理大小
                    len(rgb_batch) >= max_batch_size or  # 达到最大限制
                    (len(rgb_batch) >= min_batch_trigger and time_since_last_batch >= max_wait_time) or  # 最小触发+等待
                    (len(rgb_batch) >= 2 and time_since_last_batch >= force_timeout) or  # 降低强制处理阈值
                    (len(rgb_batch) >= 1 and time_since_last_batch >= 0.1)  # 更激进的单帧处理
                )
                
                if should_process_batch and len(rgb_batch) > 0:
                    try:
                        batch_start_time = time.time()
                        
                        if not enable_fast_mode:
                            print(f"🚀 Ultra Fast批处理: {len(rgb_batch)} 帧")
                        
                        # 处理批处理
                        self.process_batch_optimized(rgb_batch, ir_batch, original_frames)
                        
                        # 记录批处理统计
                        batch_duration = time.time() - batch_start_time
                        batch_count += 1
                        total_batch_time += batch_duration
                        display_update_counter += 1
                        
                        last_batch_process_time = current_time
                        
                    except Exception as e:
                        if not BATCH_CONFIG.get("silent_errors", False):
                            print(f"批处理异常: {e}")
                    
                    # 清空批处理缓冲区
                    rgb_batch.clear()
                    ir_batch.clear()
                    original_frames.clear()
                
                # 错误恢复机制
                if not process_frame:
                    consecutive_errors += 1
                    if consecutive_errors >= max_consecutive_errors:
                        if not enable_fast_mode:
                            print(f"连续{consecutive_errors}次处理失败，尝试快速恢复...")
                        if self.quick_recovery():
                            consecutive_errors = 0
                
                # 性能统计 - 在快速模式下减少频率
                stats_interval = 2.0 if enable_fast_mode else 1.0
                if current_time - last_fps_time >= stats_interval:
                    time_delta = current_time - last_fps_time
                    actual_rgb_fps = rgb_fps_counter / time_delta
                    actual_ir_fps = ir_fps_counter / time_delta
                    processed_fps = self.stats['frame_count'] / (current_time - self.stats['start_time'])
                    
                    avg_batch_time = total_batch_time / batch_count if batch_count > 0 else 0
                    avg_batch_fps = batch_size / avg_batch_time if avg_batch_time > 0 else 0
                    
                    print(f"📊 Ultra Fast统计: RGB={actual_rgb_fps:.1f}fps, IR={actual_ir_fps:.1f}fps, 处理={processed_fps:.1f}fps")
                    print(f"🚀 批处理性能: 大小={batch_size}, 缓存={len(rgb_batch)}, 用时={avg_batch_time:.3f}s, 批处理FPS={avg_batch_fps:.1f}")
                    
                    # 存储帧率信息
                    self.rgb_fps = actual_rgb_fps
                    self.ir_fps = actual_ir_fps
                    self.processed_fps = processed_fps
                    
                    rgb_fps_counter = 0
                    ir_fps_counter = 0
                    last_fps_time = current_time
                
                # 进一步减少延迟，提升帧率
                time.sleep(0.0001)
            
            except Exception as e:
                if not BATCH_CONFIG.get("silent_errors", False):
                    print(f"检测循环异常: {e}")
                consecutive_errors += 1
                time.sleep(0.001)
        
        # 处理剩余批处理
        if rgb_batch:
            print(f"🔄 处理剩余批处理: {len(rgb_batch)} 帧")
            self.process_batch_optimized(rgb_batch, ir_batch, original_frames)
    
    def force_disable_hevc_decoder(self):
        """简化的HEVC禁用 - 只保留最基本的设置"""
        try:
            print("🔧 简化HEVC禁用设置...")
            
            # 只设置最基本的环境变量
            os.environ['OPENCV_FFMPEG_DISABLE_HEVC'] = '1'
            os.environ['OPENCV_FFMPEG_FORCE_H264'] = '1'
            
